<% layout("/layouts/boilerplate") %>
<%= success %>
<body>

  <style>
    /* Container for filters */
    .filters {
      display: flex;
      flex-wrap: wrap; /* Allows wrapping if there are too many filters */
      gap: 2rem; /* Adds spacing between filter items */
      padding: 1rem;
      justify-content: flex-start; /* Align items to the start */
      align-items: center;
    }


    /* Individual filter item */
    .filter {
      text-align: center;
      opacity: 0.7;
      transition: opacity 0.3s ease; /* Smooth hover effect */
    }

    .filter:hover {
      opacity: 1;
      cursor: pointer;
    }

    .filter p {
      font-size: 0.8rem;
      margin: 0.5rem 0 0; /* Add some spacing below the icon */
    }

    .tax-info{
      display: none;
    }

 .tax-toggle{
  border: 1px solid black;
  border-radius: 1rem;
  height: 3.25rem;
  padding: 1rem;
  margin-left: 5rem;
  display: flex;
  align-items: center;
 }

  </style>
  <!-- Font Awesome for icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body>
  <section aria-label="Search results" class="mt-4">
    <h1>Find your next stay</h1>
    <% if (filters.q) { %><p>Results for "<%= filters.q %>"</p><% } %>
    <% if (!allListings.length) { %><p>No stays match these filters. Try another destination or <a href="/listings">clear all filters</a>.</p><% } %>
  </section>
  <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">
    <% for (let listing of allListings) { %>
      <a href="/listings/<%= listing._id %>" class="listing-link">
        <div class="card col">
          <!-- Dynamic image URL with fallback -->
          <img src="<%= listing.image?.url || '/default-image.jpg' %>" 
               class="card-img-top" 
               alt="<%= listing.title || 'Listing Image' %>"
               style="height: 20rem;" 
               onerror="this.onerror=null; this.src='/default-image.jpg';" />
               
          <div class="card-img-overlay"></div>
          <div class="card-body">
            <p class="card-text">
              <b><%= listing.title || 'Untitled Listing' %></b> <br/>
              <!-- Fallback for missing price -->
              &#8377; <%= listing.price ? listing.price.toLocaleString("en-IN") : 'Price not available' %> / night
              <i class="tax-info">&nbsp; &nbsp; +18% GST</i>
            </p>
          </div>
        </div>
      </a>
    <% } %>
  </div>
</body>

